<UserControl x:Class="VersionGit.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True"
                   Margin="15">
            <TextBlock DockPanel.Dock="Top"
                       FontSize="16"
                       FontWeight="DemiBold"
                       Text="Versiones:"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Versions}"
                      FontSize="16"
                      Margin="0,15"
                      VerticalAlignment="Top">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
        </DockPanel>

        <DockPanel Grid.Row="1"
                   Margin="15,0"
                   Visibility="{Binding EnablePush}"
                   VerticalAlignment="Top">
            <Button Command="{Binding PushCommand}"
                    Content="Publicar a Repositorio"
                    FontSize="14"
                    FontWeight="Normal" />
        </DockPanel>

        <DockPanel Grid.Row="2"
                   LastChildFill="True"
                   Margin="15">
            <TextBlock DockPanel.Dock="Top"
                       FontSize="16"
                       FontWeight="DemiBold"
                       Text="Ruta de Compilación:"
                       VerticalAlignment="Center" />
            <DockPanel Margin="0,15">
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenFolderCommand}"
                        Content="{materialIcons:MaterialIconExt Kind=Folder, IconSize=24}" />
                <TextBox Text="{Binding FolderPath}"
                         FontSize="16"
                         Margin="0,0,10,0" />
            </DockPanel>
        </DockPanel>

        <DockPanel Grid.Column="1"
                   Grid.RowSpan="3"
                   Margin="15">
            <TextBlock DockPanel.Dock="Top"
                       FontSize="16"
                       FontWeight="DemiBold"
                       Text="Etiquetas" />
            <Border BorderThickness="2"
                    Margin="0,10">
                <ListBox ItemsSource="{Binding Files}" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>