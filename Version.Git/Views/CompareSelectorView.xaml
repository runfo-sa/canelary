<UserControl x:Class="VersionGit.Views.CompareSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <sys:Boolean x:Key="BoolTrue">True</sys:Boolean>
        <sys:Boolean x:Key="BoolFalse">False</sys:Boolean>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <DockPanel LastChildFill="False"
                       Margin="5">
                <TextBlock FontSize="16"
                           FontWeight="DemiBold"
                           Text="Etiqueta 1:"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding LeftFiles}"
                          DisplayMemberPath="Name"
                          FontSize="16"
                          Margin="15,0"
                          SelectedItem="{Binding LeftFile}"
                          SelectedIndex="0" />
            </DockPanel>
            <DockPanel LastChildFill="False"
                       Margin="5"
                       Width="Auto">
                <TextBlock FontSize="16"
                           FontWeight="DemiBold"
                           Text="Versión:"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding LeftVersion}"
                          FontSize="16"
                          Margin="33, 0"
                          SelectedItem="{Binding LeftVer}"
                          SelectedIndex="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding VersionChanged}"
                                                   CommandParameter="{StaticResource BoolTrue}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="Transparent"
                BorderThickness="1" />

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center">
            <DockPanel LastChildFill="False"
                       Margin="5">
                <TextBlock FontSize="16"
                           FontWeight="DemiBold"
                           Text="Etiqueta 2:"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding RightFiles}"
                          DisplayMemberPath="Name"
                          FontSize="16"
                          Margin="15,0"
                          SelectedItem="{Binding RightFile}"
                          SelectedIndex="0" />
            </DockPanel>
            <DockPanel LastChildFill="False"
                       Margin="5">
                <TextBlock FontSize="16"
                           FontWeight="DemiBold"
                           Text="Versión:"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding RightVersion}"
                          FontSize="16"
                          Margin="33,0"
                          SelectedItem="{Binding RightVer}"
                          SelectedIndex="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding VersionChanged}"
                                                   CommandParameter="{StaticResource BoolFalse}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>