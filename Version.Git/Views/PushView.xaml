<UserControl x:Class="VersionGit.Views.PushView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converter="clr-namespace:Version.Git.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:VersionGit.Models"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converter:TypeToBrushConverter x:Key="TypeColorConverter" />
    </UserControl.Resources>

    <GroupBox>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,10">
                <TextBlock DockPanel.Dock="Top"
                           FontSize="14"
                           FontWeight="DemiBold"
                           Margin="0,5"
                           Text="{Binding TotalFiles, StringFormat='Archivos Modificados (\{0\})'}" />
                <Border BorderThickness="2">
                    <DataGrid AutoGenerateColumns="False"
                              FontSize="14"
                              IsReadOnly="True"
                              ItemsSource="{Binding ModifiedFiles}"
                              Margin="5">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}"
                                   TargetType="{x:Type DataGridRow}">
                                <Setter Property="Foreground"
                                        Value="{Binding Type, Converter={StaticResource TypeColorConverter}}" />
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Type}"
                                                Header="" />
                            <DataGridTextColumn Binding="{Binding Name}"
                                                Header="Nombre" />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="Publicar"
                                                  IsChecked="{Binding DataContext.SelectAll,
                                            RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <DockPanel Grid.Row="1"
                       LastChildFill="False"
                       Margin="0,10">
                <TextBlock DockPanel.Dock="Top"
                           FontSize="14"
                           FontWeight="DemiBold"
                           Margin="0,5"
                           Text="Branch:" />
                <ComboBox ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding Branch}"
                          SelectedIndex="0" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CreateBranch}"
                        Content="{materialIcons:MaterialIconExt Kind=Plus, Size=24}" />
            </DockPanel>

            <DockPanel Grid.Row="2"
                       Margin="0,10">
                <TextBlock FontSize="14"
                           FontWeight="DemiBold"
                           Text="Tag:"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBox FontSize="14"
                         Text="{Binding Tag}" />
            </DockPanel>

            <DockPanel Grid.Row="3"
                       Margin="0,10">
                <TextBlock FontSize="14"
                           FontWeight="DemiBold"
                           Text="Mensaje:"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBox FontSize="14"
                         Text="{Binding Message}" />
            </DockPanel>

            <Border Grid.Row="4"
                    BorderThickness="0,2,0,0">
                <DockPanel LastChildFill="False"
                           Margin="5,0">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding CancelDialogCommand}"
                            Content="Cancelar"
                            FontSize="14"
                            Margin="5" />
                    <Button DockPanel.Dock="Left"
                            Command="{Binding CloseDialogCommand}"
                            Content="Aceptar"
                            FontSize="14"
                            Margin="5" />
                </DockPanel>
            </Border>
        </Grid>
    </GroupBox>
</UserControl>