<UserControl x:Class="Cohere.Views.GenerateSample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converters="clr-namespace:Cohere.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             Height="512"
             Width="712">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window"
               BasedOn="{StaticResource MaterialDesignWindow}">
            <Setter Property="prism:Dialog.WindowStartupLocation"
                    Value="CenterScreen" />
            <Setter Property="ResizeMode"
                    Value="NoResize" />
            <Setter Property="SizeToContent"
                    Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <converters:ProductErrorToForegroundBrushConverter x:Key="ProductErrorColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid AutoGenerateColumns="False"
                  ColumnWidth="*"
                  FontSize="14"
                  IsReadOnly="True"
                  ItemsSource="{Binding ProductsList}"
                  Margin="5">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}"
                       TargetType="{x:Type DataGridRow}">
                    <Setter Property="Foreground"
                            Value="{Binding Error, Converter={StaticResource ProductErrorColorConverter}}" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Code}"
                                    Header="Codigo" />
                <DataGridTextColumn Binding="{Binding Name}"
                                    Header="Nombre"
                                    Width="3*" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Printable, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      IsEnabled="{Binding Enable}"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Content="Muestra"
                                      IsChecked="{Binding DataContext.SelectAll,
                                            RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="1"
                   Margin="10,5"
                   LastChildFill="False">
            <CheckBox DockPanel.Dock="Left"
                      Content="Generar RE-CAL-22"
                      IsChecked="{Binding EnableRecall}" />
            <Button DockPanel.Dock="Right"
                    Content="Cancelar"
                    IsCancel="True"
                    Margin="10" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding CloseDialogCommand}"
                    Content="Aceptar"
                    Margin="25,0" />
            <StackPanel DockPanel.Dock="Left"
                        Margin="25,0"
                        Orientation="Horizontal">
                <TextBlock Margin="5,0"
                           Text="Impresora: "
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding Printer}" />
            </StackPanel>
            <DatePicker materialDesign:HintAssist.Hint="Fecha"
                        SelectedDate="{Binding Fecha}"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="100"
                        Margin="0" />
        </DockPanel>

        <DockPanel Grid.Row="2"
                   Margin="10,5"
                   LastChildFill="True">
            <Label DockPanel.Dock="Left">CMD:</Label>
            <TextBox DockPanel.Dock="Right"
                     Text="{Binding AfterCommand}" />
        </DockPanel>
    </Grid>
</UserControl>