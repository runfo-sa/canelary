<UserControl x:Class="Cohere.Views.SelectRuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d">
    <GroupBox>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="Seleccionar una regla"
                   Margin="0,0,0,10" />

            <DockPanel Grid.Row="1">
                <Button DockPanel.Dock="Top"
                        Command="{Binding RemoveRuleCommand}"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,10">
                    <DockPanel>
                        <materialIcon:MaterialIcon Kind="NotebookRemove"
                                                   Width="24" />
                        <TextBlock FontSize="14"
                                   HorizontalAlignment="Center"
                                   Text="Remover Regla Aplicada"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ColumnWidth="256"
                          FontSize="14"
                          IsReadOnly="True"
                          ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}"
                                            Header="Reglas" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2"
                       LastChildFill="False"
                       Margin="0,20,0,-10">
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        FontSize="16"
                        IsCancel="True"
                        Margin="5" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="16"
                        Margin="5" />
            </DockPanel>
        </Grid>
    </GroupBox>
</UserControl>
