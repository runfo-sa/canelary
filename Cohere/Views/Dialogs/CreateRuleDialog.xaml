<UserControl x:Class="Cohere.Views.CreateRuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window"
               BasedOn="{StaticResource MaterialDesignWindow}">
            <Setter Property="prism:Dialog.WindowStartupLocation"
                    Value="CenterScreen" />
            <Setter Property="ResizeMode"
                    Value="NoResize" />
            <Setter Property="SizeToContent"
                    Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Label DockPanel.Dock="Left"
                       Content="Nombre:"
                       FontSize="16"
                       VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right"
                         FontSize="16"
                         Margin="10,0"
                         Text="{Binding RuleName}" />
            </DockPanel>

            <DockPanel Grid.Row="1"
                       Margin="0,10">
                <Label DockPanel.Dock="Left"
                       Content="Etiqueta:"
                       FontSize="16"
                       VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Right"
                          FontSize="16"
                          ItemsSource="{Binding Etiquetas}"
                          Margin="10,10"
                          SelectedIndex="0"
                          SelectedItem="{Binding Etiqueta}" />
            </DockPanel>

            <DockPanel Grid.Row="2"
                       Margin="0,10">
                <Button Click="AddAttribute"
                        Content="Agregar Atributo"
                        FontSize="18" />
            </DockPanel>

            <DataGrid Grid.Row="3"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FontSize="16"
                      ItemsSource="{Binding Attributes}"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Borrar"
                                            Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                                        Command="Delete"
                                        Content="{materialIcons:MaterialIconExt Kind=Delete, IconSize=24}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Atributo"
                                            Width="256">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Path=DataContext.AttributesList,
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                          SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding FixedValue, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Valor Fijo"
                                        Width="256">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="ToolTip"
                                        Value="Todos los productos deben tener este mismo valor" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Comentarios"
                                        Width="256" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4"
                        Margin="0,40">
                <Label Content="Descripción:"
                       FontSize="16"
                       Margin="0,0,0,10"
                       VerticalAlignment="Center" />
                <TextBox AcceptsReturn="True"
                         FontSize="14"
                         MaxHeight="256"
                         Text="{Binding Description}"
                         TextWrapping="Wrap"
                         BorderThickness="2"
                         BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                         VerticalScrollBarVisibility="Visible" />
            </StackPanel>

            <DockPanel Grid.Row="5"
                       LastChildFill="False"
                       VerticalAlignment="Bottom">
                <Button DockPanel.Dock="Right"
                        Command="{Binding CancelCommand}"
                        Content="Cancelar"
                        FontSize="16"
                        Margin="0,5" />
                <Button DockPanel.Dock="Left"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="16"
                        Margin="0,5,15,5" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>