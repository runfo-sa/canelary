<UserControl x:Class="Cohere.Views.CreateRuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d">
    <GroupBox>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Label DockPanel.Dock="Left"
                       Content="Nombre:"
                       FontSize="16"
                       VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right"
                         FontSize="16"
                         Margin="10,0"
                         Text="{Binding ReglaNombre}" />
            </DockPanel>

            <DockPanel Grid.Row="1"
                       Margin="0,10">
                <Label DockPanel.Dock="Left"
                       Content="Etiqueta:"
                       FontSize="16"
                       VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Right"
                          FontSize="16"
                          ItemsSource="{Binding Etiquetas}"
                          Margin="10,0"
                          SelectedIndex="0"
                          SelectedItem="{Binding Etiqueta}" />
            </DockPanel>

            <DockPanel Grid.Row="2"
                       Margin="10">
                <Button Click="AddAttribute"
                        Content="Agregar Atributo"
                        FontSize="16" />
            </DockPanel>

            <DataGrid Grid.Row="3"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FontSize="16"
                      ItemsSource="{Binding Atributos}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Nombre">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Path=DataContext.AtributosOpciones,
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                          SelectedItem="{Binding AtributoNombre, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Es Estatico">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding EsAtributoEstatico, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding ValorEstatico, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Valor Estatico" />
                    <DataGridTemplateColumn Header="Borrar">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="Delete"
                                        Content="Borrar" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="4"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        FontSize="16"
                        IsCancel="True"
                        Margin="5" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="16"
                        Margin="5" />
            </DockPanel>
        </Grid>
    </GroupBox>
</UserControl>
