<UserControl x:Class="Cohere.Views.GenerateRecallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <GroupBox>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <Label Content="Solicitado por"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Margin="5" />
                        <TextBox x:Name="solicitado"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right">
                        <Label Content="Destino"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Margin="5" />
                        <TextBox x:Name="destino"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Left"
                        Grid.Row="1">
                <Label Content="Motivo"
                       FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                       Margin="5" />
                <TextBox x:Name="motivo"
                         HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Left"
                        Grid.Row="2">
                <Label Content="Detalle de la modificación"
                       FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                       Margin="5" />
                <TextBox x:Name="detalle"
                         HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Left"
                        Grid.Row="3">
                <Label Content="Observaciones adicionales"
                       FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                       Margin="5" />
                <TextBox x:Name="observaciones"
                         HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <DockPanel Grid.Row="4">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <Label Content="Etiqueta Vigente"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Margin="5" />
                        <TextBox x:Name="etiqueta_before"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right">
                        <Label Content="Etiqueta Solicitada"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Margin="5" />
                        <TextBox x:Name="etiqueta_after"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>

            <DockPanel Grid.Row="5">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <Label Content="Autor"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Margin="5" />
                        <TextBox x:Name="autor"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right">
                        <Label FontWeight="DemiBold"
                               HorizontalAlignment="Center"
                               Content="Fecha de solicitud"
                               Margin="5" />
                        <TextBox x:Name="fecha_solicitud"
                                 MaxWidth="150"
                                 MinWidth="150" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Left"
                        Grid.Row="6">
                <Label Content="Impresoras afectadas"
                       FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                       Margin="5" />
                <TextBox x:Name="impresora"
                         HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <DockPanel Grid.Row="7"
                       LastChildFill="False"
                       Margin="0,10,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        FontSize="14"
                        IsCancel="True"
                        Margin="5" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="14"
                        Margin="5" />
            </DockPanel>
        </Grid>
    </GroupBox>
</UserControl>
