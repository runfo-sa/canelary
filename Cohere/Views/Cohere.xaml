<UserControl x:Class="Cohere.Views.Cohere"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl prism:RegionManager.RegionName="Cohere#MenuRegion" />

        <Grid Grid.Row="1"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Bottom"
                        Command="{Binding GenerateSampleCommand}"
                        Content="Generar Muestra"
                        FontSize="14"
                        Margin="0,10"
                        VerticalAlignment="Bottom" />
                <ContentControl prism:RegionManager.RegionName="Cohere#TreeRegion" />
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Background="{x:Null}"
                          HorizontalAlignment="Stretch" />

            <ContentControl Grid.Column="2"
                            prism:RegionManager.RegionName="Cohere#ProductListRegion" />

            <GridSplitter Grid.Column="3"
                          Background="{x:Null}"
                          HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="4"
                       Background="{DynamicResource {x:Static adonisUi:Brushes.Layer4BackgroundBrush}}"
                       LastChildFill="False">
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}"
                        BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}"
                        BorderThickness="5">
                    <StackPanel Margin="5,0,5,25">
                        <Label Content="Reporte"
                               FontSize="18"
                               FontWeight="DemiBold"
                               Margin="0,0,0,15" />
                        <TextBlock FontSize="14"
                                   Text="{Binding ErrorCount, StringFormat='Errores encontrados: {0}'}" />
                    </StackPanel>
                </Border>

                <ContentControl prism:RegionManager.RegionName="Cohere#ProductReportRegion" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
