            |RO
            |SD
            |TA
            |WC
            |WQ)
        </Rule>

        <Rule color="Variable">
            \[@(.+?)@\]
        </Rule>

        <Rule color="String">
            (?&lt;=\^FD)(.+?)(?=\[@)|(?&lt;=@\])(.+?)(?=\[@)|(?&lt;=@\])(.+?)(?=\^FS)|(?&lt;=\^FD)(.+)(?=\^FS)
        </Rule>

        <Rule color="Numbers">
            (\d+(\.[0-9]+)? | \.[0-9]+)
        </Rule>
    </RuleSet>
</SyntaxDefinition>