<UserControl x:Class="Main.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="15">
        <TextBlock Text="Nueva Actualización!"
                   Margin="0,10"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   FontWeight="Medium" />

        <Separator Background="{DynamicResource SecondaryHueMidBrush}"
                   Margin="0,5" />

        <TextBlock Margin="0,5"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   FontWeight="Medium">
            <TextBlock.Text>
                <MultiBinding  StringFormat="{}Versión: {0} -> {1}">
                    <Binding Path="OldVersion" />
                    <Binding Path="Version" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Text="Cambios:"
                   Margin="0,10,0,5"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   FontWeight="Medium" />

        <TextBlock Text="{Binding Changelog}"
                   FontSize="14"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Left" />

        <Separator Background="{DynamicResource SecondaryHueMidBrush}"
                   Margin="0,15" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Content="Actualizar"
                    IsEnabled="{Binding EnableButton}"
                    Command="{Binding UpdateCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="Cancelar"
                    IsEnabled="{Binding EnableButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </DockPanel>
    </StackPanel>
</UserControl>