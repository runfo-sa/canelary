<Window x:Class="Main.Views.TabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Core.Models;assembly=Core"
        xmlns:local="clr-namespace:Main.Views"
        mc:Ignorable="d"
        Title="Canelary"
        Height="690"
        Width="1024"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="../Resources/#Kumbh Sans Light"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <dockablz:Layout>
            <dragablz:TabablzControl x:Name="Tabs"
                                     ShowDefaultCloseButton="True">
                <dragablz:TabablzControl.InterTabController>
                    <dragablz:InterTabController />
                </dragablz:TabablzControl.InterTabController>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type models:ModuleTab}">
                        <ContentControl Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
                <dragablz:TabablzControl.HeaderItemTemplate>
                    <DataTemplate DataType="{x:Type models:ModuleTab}">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </dragablz:TabablzControl.HeaderItemTemplate>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ModuleTab}">
                        <ContentControl Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </dragablz:TabablzControl>
        </dockablz:Layout>
    </Grid>
</Window>