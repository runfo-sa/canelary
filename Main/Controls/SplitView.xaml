<UserControl x:Class="Main.Controls.SplitView"
             x:Name="sp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
             xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:Core.Models;assembly=Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Height="690"
             d:Width="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CompactPane" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="SidePane"
              Background="#9B8E87">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="15">
                <Label x:Name="Title"
                       Content="Canelary"
                       FontSize="20" />
                <Button x:Name="DisplayPaneBtn"
                        Click="DisplayPaneBtn_Click"
                        Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                        HorizontalAlignment="Right" />
            </DockPanel>

            <Separator Grid.Row="1"
                       Height="24"
                       Background="Transparent" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="SideBar"
                            Margin="15" />
            </ScrollViewer>

            <Separator Grid.Row="1"
                       Height="24"
                       Background="Transparent" />

            <DockPanel Grid.Row="2"
                       Margin="15,5">
                <Button x:Name="SettingsBtn"
                        DockPanel.Dock="Left"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}">
                    <materialIcons:MaterialIcon Kind="CogOutline"
                                                Width="Auto" />
                </Button>
                <Label x:Name="VersionLabel"
                       DockPanel.Dock="Right"
                       FontSize="10"
                       FontWeight="Thin"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Content="{Binding Version}" />
            </DockPanel>
        </Grid>

        <Grid x:Name="MainPane"
              Grid.Column="1">
            <dockablz:Layout>
                <dragablz:TabablzControl x:Name="Tabs"
                                         Visibility="Hidden"
                                         ShowDefaultCloseButton="True">
                    <dragablz:TabablzControl.InterTabController>
                        <dragablz:InterTabController InterTabClient="{Binding InterTabClientInstance}" />
                    </dragablz:TabablzControl.InterTabController>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type models:ModuleTab}">
                            <ContentControl Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                    <dragablz:TabablzControl.HeaderItemTemplate>
                        <DataTemplate DataType="{x:Type models:ModuleTab}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </dragablz:TabablzControl.HeaderItemTemplate>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ModuleTab}">
                            <ContentControl Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </dragablz:TabablzControl>
            </dockablz:Layout>
        </Grid>
    </Grid>
</UserControl>