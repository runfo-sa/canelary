<UserControl x:Class="Editor.Views.Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding CommandService.PreviewCommand}"
                    Key="F5" />
        <KeyBinding Command="{Binding CommandService.PrintCommand}"
                    Key="F6" />
        <KeyBinding Command="{Binding CommandService.NewCommand}"
                    Key="N"
                    Modifiers="Ctrl" />
        <KeyBinding Command="{Binding CommandService.OpenCommand}"
                    Key="O"
                    Modifiers="Ctrl" />
        <KeyBinding Command="{Binding CommandService.SaveCommand}"
                    Key="S"
                    Modifiers="Ctrl" />
        <KeyBinding Command="{Binding CommandService.SaveAllCommand}"
                    Key="S"
                    Modifiers="Ctrl+Shift" />
        <KeyBinding Command="{Binding CommandService.CloseCommand}"
                    Key="W"
                    Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl prism:RegionManager.RegionName="Editor#MenuRegion" />
        <ContentControl Grid.Row="1"
                        prism:RegionManager.RegionName="Editor#ToolbarRegion" />

        <Grid Grid.Row="2"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <ContentControl prism:RegionManager.RegionName="Editor#TreeRegion" />
            <GridSplitter Grid.Column="1"
                          Background="{x:Null}"
                          HorizontalAlignment="Stretch" />
            <ContentControl Grid.Column="2"
                            prism:RegionManager.RegionName="Editor#TextEditorRegion" />
            <GridSplitter Grid.Column="3"
                          Background="{x:Null}"
                          HorizontalAlignment="Stretch" />
            <ContentControl Grid.Column="4"
                            prism:RegionManager.RegionName="Editor#PreviewRegion" />
        </Grid>
    </Grid>
</UserControl>