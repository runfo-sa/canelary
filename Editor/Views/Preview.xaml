<UserControl x:Class="Editor.Views.Preview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:coreControls="clr-namespace:Core.Controls;assembly=Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False"
                   Margin="5">
            <TextBlock FontSize="24"
                       FontWeight="DemiBold"
                       Text="Preview"
                       VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right"
                    Command="{Binding RotateRightCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=RotateRight, Size=24}"
                    VerticalAlignment="Center" />
            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="10" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding RotateLeftCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=RotateLeft, Size=24}"
                    VerticalAlignment="Center" />

            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="20" />

            <Button DockPanel.Dock="Right"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding NextLabel}"
                    Content="{materialIcons:MaterialIconExt Kind=ArrowRightDropCircle,Size=20}"
                    FontWeight="DemiBold"
                    VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right"
                       FontSize="20"
                       Margin="5,0"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}">
                        <Binding Path="CurrentLabel" />
                        <Binding Path="TotalLabel" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button DockPanel.Dock="Right"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding PreviousLabel}"
                    Content="{materialIcons:MaterialIconExt Kind=ArrowLeftDropCircle,Size=20}"
                    FontWeight="DemiBold"
                    VerticalAlignment="Center" />
        </DockPanel>

        <coreControls:ZoomBorder Grid.Row="1"
                                 Background="{DynamicResource {x:Static adonisUi:Brushes.Layer4BackgroundBrush}}"
                                 BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer4BorderBrush}}"
                                 BorderThickness="2"
                                 ClipToBounds="True"
                                 Margin="5">
            <Image SnapsToDevicePixels="True"
                   Source="{Binding PreviewImage}" />
        </coreControls:ZoomBorder>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="5">
            <TextBlock FontSize="14"
                       FontWeight="DemiBold"
                       Text="DPI:"
                       VerticalAlignment="Center" />
            <Separator Opacity="0"
                       Width="10" />
            <ComboBox DisplayMemberPath="Display"
                      ItemsSource="{Binding DpiList}"
                      FontSize="13"
                      SelectedIndex="2"
                      SelectedValuePath="Value" />
            <ComboBox DockPanel.Dock="Right"
                      DisplayMemberPath="Display"
                      ItemsSource="{Binding SizeList}"
                      FontSize="13"
                      SelectedValuePath="Value">
                <ComboBox.ToolTip>
                    <StackPanel>
                        <TextBlock><Bold>Shift + E</Bold> - Para bajar un item</TextBlock>
                        <TextBlock><Bold>Shift + Q</Bold> - Para subir un item</TextBlock>
                    </StackPanel>
                </ComboBox.ToolTip>
            </ComboBox>
            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="10" />
            <TextBlock DockPanel.Dock="Right"
                       FontSize="14"
                       FontWeight="DemiBold"
                       Text="Size:"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>