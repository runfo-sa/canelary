<UserControl x:Class="Editor.Views.Preview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:coreControls="clr-namespace:Core.Controls;assembly=Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False"
                   Margin="10">
            <Label FontSize="24"
                   Content="Preview"
                   VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right"
                    Command="{Binding RotateRightCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=RotateRight}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                    VerticalAlignment="Center" />
            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="10" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding RotateLeftCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=RotateLeft}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                    VerticalAlignment="Center" />

            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="20" />

            <Button DockPanel.Dock="Right"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding NextLabel}"
                    Content="{materialIcons:MaterialIconExt Kind=ArrowRightDropCircle}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                    VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right"
                       FontSize="20"
                       Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                       Margin="5,0"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}">
                        <Binding Path="CurrentLabel" />
                        <Binding Path="TotalLabel" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button DockPanel.Dock="Right"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding PreviousLabel}"
                    Content="{materialIcons:MaterialIconExt Kind=ArrowLeftDropCircle}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                    VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="10,0,10,10"
                BorderThickness="5"
                BorderBrush="{DynamicResource PrimaryHueMidBrush}">
            <coreControls:ZoomBorder ClipToBounds="True"
                                     Margin="5">
                <Image SnapsToDevicePixels="True"
                       Source="{Binding PreviewImage}" />
            </coreControls:ZoomBorder>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="20,0,20,20">
            <TextBlock FontSize="14"
                       Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                       Text="DPI:"
                       VerticalAlignment="Center" />
            <Separator Opacity="0"
                       Width="10" />
            <ComboBox DisplayMemberPath="Display"
                      ItemsSource="{Binding DpiList}"
                      FontSize="12"
                      Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                      SelectedIndex="2"
                      SelectedValuePath="Value" />
            <ComboBox DockPanel.Dock="Right"
                      DisplayMemberPath="Display"
                      ItemsSource="{Binding SizeList}"
                      FontSize="12"
                      Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                      SelectedValuePath="Value">
                <ComboBox.ToolTip>
                    <StackPanel>
                        <TextBlock><Bold>Shift + E</Bold> - Para bajar un item</TextBlock>
                        <TextBlock><Bold>Shift + Q</Bold> - Para subir un item</TextBlock>
                    </StackPanel>
                </ComboBox.ToolTip>
            </ComboBox>
            <Separator DockPanel.Dock="Right"
                       Opacity="0"
                       Width="10" />
            <TextBlock DockPanel.Dock="Right"
                       FontSize="14"
                       Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                       Text="Size:"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>