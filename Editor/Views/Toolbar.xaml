<UserControl x:Class="Editor.Views.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Focusable="True"
             mc:Ignorable="d">

    <ToolBarTray DockPanel.Dock="Left"
                 IsLocked="True">
        <ToolBar ClipToBounds="False"
                 Style="{StaticResource MaterialDesignToolBar}">
            <Button x:Name="newButton"
                    Background="{x:Null}"
                    Command="{Binding CommandService.NewCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=FileOutline}"
                    Margin="5,0"
                    ToolTip="Ctrl + N" />
            <Button x:Name="openButton"
                    Background="{x:Null}"
                    Command="{Binding CommandService.OpenCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=FolderOpenOutline}"
                    Margin="5,0"
                    ToolTip="Ctrl + O" />
            <Button x:Name="saveButton"
                    Background="{x:Null}"
                    Command="{Binding CommandService.SaveCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=ContentSaveOutline}"
                    Margin="5,0"
                    ToolTip="Ctrl + S" />
            <Button x:Name="saveAllButton"
                    Background="{x:Null}"
                    Command="{Binding CommandService.SaveAllCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=ContentSaveAllOutline}"
                    Margin="5,0"
                    ToolTip="Ctrl + Shift + S" />
            <Separator />
            <Button x:Name="resolutionButton"
                    Command="{Binding CommandService.ResizeCommand}"
                    Margin="5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Cambiar resolución"
                               VerticalAlignment="Center" />
                    <materialIcons:MaterialIcon Kind="Resize" />
                </DockPanel>
            </Button>
            <Separator />
            <Button x:Name="previewButton"
                    Command="{Binding CommandService.PreviewCommand}"
                    Margin="5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Previsualizar [F5]"
                               VerticalAlignment="Center" />
                    <materialIcons:MaterialIcon Kind="ImageOutline" />
                </DockPanel>
            </Button>
            <Button Command="{Binding CommandService.PrintCommand}"
                    Margin="5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Margin="5,0"
                               Text="Imprimir [F6]"
                               VerticalAlignment="Center" />
                    <materialIcons:MaterialIcon Kind="PrinterOutline" />
                </DockPanel>
            </Button>
            <ComboBox ItemsSource="{Binding Printers}"
                      Margin="5,0"
                      SelectedIndex="0"
                      Style="{StaticResource {x:Type ComboBox}}"
                      IsSynchronizedWithCurrentItem="True" />
        </ToolBar>
    </ToolBarTray>
</UserControl>