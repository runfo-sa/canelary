<UserControl x:Class="Comparator.Views.SelectLabelsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             Height="325"
             Width="450">
    <Grid Margin="10">
        <ProgressBar x:Name="LoadingBar"
                     Grid.RowSpan="3"
                     Visibility="Collapsed"
                     IsIndeterminate="True"
                     Width="50"
                     Height="50"
                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                     Value="0">
            <ProgressBar.LayoutTransform>
                <ScaleTransform CenterX="0.5"
                                CenterY="0.5"
                                ScaleX="2"
                                ScaleY="2" />
            </ProgressBar.LayoutTransform>
        </ProgressBar>

        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                    BorderThickness="2">
                <ContentControl prism:RegionManager.RegionName="Comparator#Selector"
                                Margin="5" />
            </Border>

            <DockPanel Grid.Row="1"
                       LastChildFill="False"
                       Margin="0,20">
                <TextBlock DockPanel.Dock="Left"
                           FontSize="14"
                           FontWeight="DemiBold"
                           Text="DPI:"
                           VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Left"
                          DisplayMemberPath="Display"
                          ItemsSource="{Binding DpiList}"
                          FontSize="13"
                          Margin="5,0"
                          SelectedIndex="2"
                          SelectedValuePath="Value" />
                <ComboBox DockPanel.Dock="Right"
                          DisplayMemberPath="Display"
                          ItemsSource="{Binding SizeList}"
                          FontSize="13"
                          Margin="5,0"
                          SelectedValuePath="Value" />
                <TextBlock DockPanel.Dock="Right"
                           FontSize="14"
                           FontWeight="DemiBold"
                           Text="Size:"
                           VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="2"
                       LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        x:Name="acceptButton"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="16"
                        Margin="5" />
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        FontSize="16"
                        IsCancel="True"
                        Margin="5" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>