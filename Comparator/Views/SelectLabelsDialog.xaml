<UserControl x:Class="Comparator.Views.SelectLabelsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <GroupBox>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Transparent"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer4BorderBrush}}"
                    BorderThickness="2">
                <ContentControl prism:RegionManager.RegionName="Comparator#Selector" />
            </Border>

            <DockPanel Grid.Row="1"
                       LastChildFill="False"
                       Margin="0,10">
                <TextBlock FontSize="14"
                           FontWeight="DemiBold"
                           Text="DPI:"
                           VerticalAlignment="Center" />
                <ComboBox DisplayMemberPath="Display"
                          ItemsSource="{Binding DpiList}"
                          FontSize="13"
                          Margin="5,0"
                          SelectedIndex="2"
                          SelectedValuePath="Value" />
                <ComboBox DockPanel.Dock="Right"
                          DisplayMemberPath="Display"
                          ItemsSource="{Binding SizeList}"
                          FontSize="13"
                          Margin="5,0"
                          SelectedValuePath="Value" />
                <TextBlock DockPanel.Dock="Right"
                           FontSize="14"
                           FontWeight="DemiBold"
                           Text="Size:"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer4BorderBrush}}"
                    BorderThickness="1" />

            <DockPanel Grid.Row="3"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        FontSize="16"
                        IsCancel="True"
                        Margin="5" />
                <Button x:Name="acceptButton"
                        DockPanel.Dock="Right"
                        Command="{Binding CloseDialogCommand}"
                        Content="Aceptar"
                        FontSize="16"
                        Margin="5" />
            </DockPanel>
        </Grid>
    </GroupBox>
</UserControl>