<UserControl x:Class="Comparator.Views.Comparator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:coreView="clr-namespace:Core.Views;assembly=Core"
             xmlns:view="clr-namespace:Comparator.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <materialDesign:DialogHost x:Name="dialog"
                               Identifier="{Binding DialogIdentifier}"
                               CloseOnClickAway="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding ChangeFilesCommand}"
                        Content="{materialIcons:MaterialIconExt Kind=Plus, Size=24}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                        FontSize="14"
                        FontWeight="Bold">
                    <Button.ToolTip>
                        <TextBlock Text="Cambiar comparacion" />
                    </Button.ToolTip>
                </Button>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Click="SwitchToTextMode"
                            Content="Codigo"
                            FontSize="14"
                            FontWeight="DemiBold">
                        <Button.Style>
                            <Style BasedOn="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                                   TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TextMode}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource PrimaryHueDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Click="SwitchToImageMode"
                            Content="Imagen"
                            FontSize="14"
                            FontWeight="DemiBold">
                        <Button.Style>
                            <Style BasedOn="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                                   TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageMode}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource PrimaryHueDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Content="{materialIcons:MaterialIconExt Kind=Refresh, Size=24}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                        FontSize="14"
                        FontWeight="Bold">
                    <Button.ToolTip>
                        <TextBlock Text="Refrescar comparacion" />
                    </Button.ToolTip>
                </Button>
            </Grid>

            <ContentControl Grid.Row="1"
                            Margin="15,0,15,15"
                            prism:RegionManager.RegionName="ContentRegion" />
        </Grid>
    </materialDesign:DialogHost>
</UserControl>